{
  "name": "dreamscape-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -w --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "check": "tsc && node --env-file-if-exists=.env dist/check.js",
    "voices": "tsc && node --env-file-if-exists=.env dist/voices.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
