# Dreamscape narrator service.
# Copy to .env and fill in what you have. Everything is optional — with no keys
# at all the app still runs end to end on its built-in engine.

# ---- Narrator (writes and plans the night) ----------------------------------
# Without this the app falls back to its local engine.
ANTHROPIC_API_KEY=

# ---- Voice (speaks the night) -----------------------------------------------
# Preferred: ElevenLabs. Its v3 models read the inline performance markers the
# narrator writes — [breathes], [sighs], [laughs], [whispers], [pause] — as real
# breath and laughter.
#
# Voice ids are account-specific. Set ELEVENLABS_VOICE_ID for a single default,
# and optionally one per preference to give each voice setting its own actor.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=
# ELEVENLABS_VOICE_NEUTRAL=
# ELEVENLABS_VOICE_WARM=
# ELEVENLABS_VOICE_DEEP=
# ELEVENLABS_VOICE_WHISPER=
# ELEVENLABS_MODEL=eleven_v3

# Fallback: OpenAI speech. No inline markers, so they are lifted out of the text
# and folded into the `instructions` field instead.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Service ----------------------------------------------------------------
# PORT=8787
# CORS_ORIGIN=http://localhost:5173
