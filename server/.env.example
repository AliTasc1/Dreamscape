# Dreamscape narrator service.
#
#   cp .env.example .env     then fill in what you have
#   npm run voices           lists your ElevenLabs voice ids
#   npm run check            proves both keys actually work
#
# Everything here is optional. With no keys at all the app still runs end to
# end: it writes the night with its own engine and speaks it with the browser's
# own speech synthesis.

# ---- Narrator: writes and plans the night ----------------------------------
# Either of these writes the night. Set both and ANTHROPIC wins unless
# NARRATOR says otherwise; set neither and the device writes it itself, which
# always works and costs nothing.

# Free tier, no card: aistudio.google.com -> Get API key. A few hundred
# requests a day, which is a couple of nights. Check the current limits at
# https://ai.google.dev/gemini-api/docs/pricing before relying on a number.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Paid, and the better writer. console.anthropic.com -> API keys.
# Credits are separate: Plans & Billing.
ANTHROPIC_API_KEY=

# Which model writes the night. Opus is the default and the best writer; a
# night is many requests, so this is the one lever that moves the bill.
#   claude-opus-5     $5 / $25 per million tokens  (default)
#   claude-sonnet-5   $2 / $10  — noticeably cheaper, still a strong writer
#   claude-haiku-4-5  $1 / $5   — cheapest, plainest prose
# ANTHROPIC_MODEL=claude-sonnet-5

# Which one writes, when both keys are here. `claude` or `gemini`.
# NARRATOR=gemini

# ---- Voice: speaks it ------------------------------------------------------
# Preferred: ElevenLabs. Its v3 model reads the inline performance markers the
# narrator writes — [breathes], [sighs], [laughs], [whispers], [pause] — as real
# breath and laughter. Nothing else on the market performs them from the text.
#
# elevenlabs.io -> profile -> API key
ELEVENLABS_API_KEY=

# Voice ids are per-account, so they cannot ship as defaults.
# Run `npm run voices` and paste one in here.
ELEVENLABS_VOICE_ID=

# Optional: give each voice preference its own actor. Anything left unset
# falls back to ELEVENLABS_VOICE_ID above.
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=
# ELEVENLABS_VOICE_NEUTRAL=
# ELEVENLABS_VOICE_WARM=
# ELEVENLABS_VOICE_DEEP=
# ELEVENLABS_VOICE_WHISPER=

# eleven_v3 is the expressive model that performs the markers. Swap to
# eleven_multilingual_v2 for cheaper, flatter, more predictable delivery, or
# eleven_flash_v2_5 for the lowest latency.
# ELEVENLABS_MODEL=eleven_v3

# Some models accept an explicit language_code and some reject it outright.
# Off by default; the model is left to detect the language from the text.
# ELEVENLABS_SEND_LANGUAGE=true

# Fallback: OpenAI speech. No inline markers, so they are lifted out of the
# text and folded into its `instructions` field instead.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Service ---------------------------------------------------------------
# PORT=8787

# Who may call this service from a browser. The default is "*", which is right
# while you are developing on your own machine and wrong the moment this is on
# a public address: with "*", any website can drive your keys. Set it to the
# origin the app is served from.
# CORS_ORIGIN=http://localhost:5173

# Per-address budget. Every request here spends your money, so an open port is
# an open wallet. 40 requests a minute is comfortable for one listener — a
# night is one plan plus a segment every few minutes — and far too slow to be
# worth abusing.
# RATE_MAX=40
# RATE_WINDOW_MS=60000

# Behind a proxy or a tunnel (Cloudflare, Fly, Render, nginx), set this so the
# budget follows the real caller instead of counting everyone as the proxy.
# Leave it off otherwise: a client can forge X-Forwarded-For.
# TRUST_PROXY=1

# Where the built web app is. Defaults to ../app/dist.
# STATIC_DIR=/path/to/app/dist
