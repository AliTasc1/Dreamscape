{
  "name": "dreamscape-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "share": "node scripts/tunnel.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "publish": "eas update --branch preview --message \"Dreamscape\"",
    "export": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  },
  "comments": {
    "versions": "Every version here is the one Expo SDK 57 bundles (expo/bundledNativeModules.json). Expo Go ships exactly these native modules, so a newer one does not load — it fails on the phone, not here.",
    "overrides": "xcode pulls uuid@7, which has a moderate advisory. xcode only ever calls uuid.v4() with no buffer, and only during a local prebuild, so it was never reachable — but v11 satisfies it and keeps `npm audit` clean."
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
